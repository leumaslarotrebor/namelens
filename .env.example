# Copy to .env for local runs. NameLens needs no API keys: Wikidata and Wikipedia are queried through their public APIs.
DATABASE_URL=sqlite:///./namelens.db
# docker compose sets this to the bundled PostgreSQL service:
# DATABASE_URL=postgresql://namelens:namelens@db:5432/namelens
CORS_ORIGINS=http://localhost:5173
WEB_DIST=../web/dist
ENABLE_WIKIDATA=true
ENABLE_WIKIPEDIA=true
ENABLE_DEMO_PROVIDER=true
HTTP_TIMEOUT_SECONDS=6
CACHE_TTL_SECONDS=3600
